
# worktrees + local claude state
.claude/

# dependencies — restored by `npm ci` from package-lock.json, never committed
node_modules/

# build output — regenerated by `npm run build`, deployed from CI
dist/

# driver and lookdev screenshots — regenerated by `npm run shoot` and by the drivers themselves.
#
# These were tracked, and they were 37 MiB of the 65 MB repository: every driver run rewrote
# them non-deterministically, so each run offered a new revision to commit. Nothing ever
# referenced them as images — every mention in the docs is prose about where a tool WRITES.
# A screenshot worth showing is worth committing on purpose.
shots/
