{
  "name": "heirloom",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "soak": "node tools/soak.mjs",
    "measure": "node tools/measure-depth.mjs",
    "shoot": "node tools/shoot-garden.mjs",
    "shoot:lookdev": "node tools/shoot.mjs",
    "drive": "node tools/run-drivers.mjs && node tools/check-motion.mjs && node tools/check-viewports.mjs && node tools/check-clock.mjs && node tools/check-growth-fps.mjs && node tools/check-phone.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "playwright": "^1.62.1"
  }
}
